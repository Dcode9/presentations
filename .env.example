# Cerebras API key (required) - Get yours at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Pollinations API key (optional) - Get yours at https://enter.pollinations.ai/
# If not set, images will still be generated but may be rate-limited.
POLLINATIONS_API_KEY=your_pollinations_api_key_here
